# Dependencies
node_modules
# フォントサブセット生成(scripts/build-font-subset.mjs)用のPython venv。
# macOSのpython3はPEP 668で外部管理のため、システムに直接入れずここに隔離する。
.venv

# Build output
dist
# docs (GitHub Pagesのためコミットする)
dist-ssr
*.local

# Playwright MCPの検証用スクショ/ログ
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history

# Environment variables
.env
.env.local
.env.*.local

# markdwon
*.md
# documentation/配下は実装ドキュメントとしてコミットする(docs/はビルド成果物のため別物)
!documentation/*.md

# SVG icon generator
svg/node_modules/
svg/package-lock.json

# spotify-data.json
public/spotify-data.json
docs/spotify-data.json

# folder
ignore/
ignore/*
ignore_project/
ignore_project/*

# spotify-data
docs/spotify-data.json
public/spotify-data.json
 
