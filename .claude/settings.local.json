{
  "permissions": {
    "allow": [
      "Bash(npm run sync-header)",
      "Bash(npm install:*)",
      "Bash(npm run build)",
      "mcp__playwright__browser_navigate"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); if echo \"$file\" | grep -qE '(Header\\.jsx|Header\\.css)$'; then npm run sync-header; fi"
          }
        ]
      }
    ]
  }
}
